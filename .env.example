# Cadena de conexión a Postgres. Vercel Postgres/Neon la generan automáticamente
# al conectar el storage; para otros proveedores (Supabase, Railway) cópiala desde
# su panel y pégala aquí (en local) o en Vercel > Settings > Environment Variables.
DATABASE_URL=postgres://usuario:password@host:5432/basededatos

# --- Correo automático (asignaciones y check-in de fecha límite) ---

# API key de Resend (https://resend.com). Sin esto, la app funciona igual pero
# no manda correos (queda registrado en los logs de Vercel).
RESEND_API_KEY=

# Remitente. Mientras no verifiques el dominio solarityenergia.com en Resend,
# usa el dominio de pruebas de Resend tal cual:
EMAIL_FROM=Iniciativas Solarity <onboarding@resend.dev>

# A dónde llegan las respuestas si alguien responde el correo directamente
# (en vez de usar los botones). Pon aquí tu correo de Outlook.
EMAIL_REPLY_TO=alfonso.salazar@solarityenergia.com

# URL pública de tu app ya desplegada (sin / al final), ej:
# https://mis-iniciativas.vercel.app
# Se usa para armar los links "Ver detalle y comentar" dentro de los correos.
APP_URL=

# Secreto para proteger el endpoint de check-in diario (/api/cron/checkin).
# Genera cualquier texto largo al azar y ponlo también en Vercel; Vercel Cron
# lo manda automáticamente como Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
